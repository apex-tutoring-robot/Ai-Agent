# Azure Speech Services
AZURE_SPEECH_KEY=your_azure_speech_key
AZURE_SPEECH_REGION=your_azure_speech_region

# Azure OpenAI
AZURE_OPENAI_KEY=your_azure_openai_key
AZURE_OPENAI_ENDPOINT=your_azure_openai_endpoint
AZURE_OPENAI_DEPLOYMENT=your_azure_openai_deployment
AZURE_OPENAI_API_VERSION=your_azure_openai_api_version

# Picovoice Wake Word
PICOVOICE_ACCESS_KEY=your_picovoice_access_key
WAKE_WORD_MODEL_PATH=your_wake_word_model_path

WAKE_WORD_MODEL="hey_jarvis"
WAKE_WORD_THRESHOLD=0.5
WAKE_WORD_VAD_THRESHOLD=0.5

# USB Audio Device Configuration
# Run 'python -c "import pyaudio; p = pyaudio.PyAudio(); [print(f\"{i}: {p.get_device_info_by_index(i)['name']}\") for i in range(p.get_device_count())]"'
# to list available audio devices and their indices
AUDIO_INPUT_DEVICE_INDEX=1
AUDIO_OUTPUT_DEVICE_INDEX=1

# Audio Parameters
SAMPLE_RATE=16000
CHANNELS=1
CHUNK_SIZE=512
VAD_AGGRESSIVENESS=3
SILENCE_TIMEOUT_MS=1500

# Conversation Settings
MAX_CONVERSATION_HISTORY=20
SYSTEM_PROMPT_PATH=./config/system_prompt.txt
CONVERSATION_IDLE_TIMEOUT_SECONDS=10

# TTS Settings
TTS_VOICE=en-US-JennyNeural
TTS_SPEECH_RATE=1.0

# Logging
LOG_LEVEL=INFO

# AEC & Full-Duplex Tuning
AEC_DELAY_CHUNKS=12
AEC_HARDWARE_LATENCY_MS=150
ENABLE_INTERRUPTION=true

# Camera Vision
CAMERA_DEVICE_INDEX=3

# Face Animation
# DISPLAY_BACKEND: physical (HDMI → :0) | vnc (TigerVNC → :1) | auto (first available socket)
FACE_ENABLED=true
DISPLAY_BACKEND=vnc

# Azure Blob Storage (camera vision — upload image once, reference by SAS URL)
# Get connection string from: Azure Portal → Storage Account → Access Keys
AZURE_STORAGE_CONNECTION_STRING=your_azure_storage_connection_string
AZURE_STORAGE_CONTAINER_NAME=your_container_name

# NeMo Guardrails
GUARDRAILS_CONFIG_PATH=config/guardrails
GUARDRAILS_ENABLED=true
