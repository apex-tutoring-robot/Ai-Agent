# Azure Speech Services
AZURE_SPEECH_KEY=your_azure_speech_key
AZURE_SPEECH_REGION=your_azure_speech_region

# Azure OpenAI
AZURE_OPENAI_API_KEY=your_azure_openai_key
AZURE_OPENAI_ENDPOINT=your_azure_openai_endpoint
AZURE_OPENAI_DEPLOYMENT=your_azure_openai_deployment
AZURE_OPENAI_API_VERSION=your_azure_openai_api_version

# openwakeword
WAKE_WORD_MODEL="hey_jarvis"
WAKE_WORD_THRESHOLD=0.5
WAKE_WORD_VAD_THRESHOLD=0.5

# USB Audio Device Configuration
#
# Resolved by NAME, not index (see src/audio/device_finder.py) — PyAudio
# device indices are assigned by USB enumeration order and shift across
# reboots/re-plugs, so a hardcoded index silently breaks whenever the
# machine boots with devices enumerated differently. Run
# `python tests/test_list_devices.py` to see what's plugged in and what
# currently gets auto-resolved for these hints.
AUDIO_INPUT_DEVICE_NAME=usb pnp
AUDIO_OUTPUT_DEVICE_NAME=usb pnp

# Audio Parameters
SAMPLE_RATE=16000
CHANNELS=1
VAD_AGGRESSIVENESS=3
VAD_FRAME_DURATION_MS=20
SILENCE_TIMEOUT_MS=1500

# Conversation Settings
MAX_CONVERSATION_HISTORY=20
SYSTEM_PROMPT_PATH=./config/system_prompt.txt
CONVERSATION_IDLE_TIMEOUT_SECONDS=10
DISPLAY_SLEEP_TIMEOUT=60

# TTS Settings
TTS_VOICE=en-US-JennyNeural
TTS_SPEECH_RATE=1.0

# Logging
LOG_LEVEL=INFO
LOG_DIR=None

# AEC & Full-Duplex Tuning
AEC_DELAY_CHUNKS=12
FACE_ENABLED=true
BARGE_IN_GRACE_S=2.0
ENABLE_SPEEX_NOISE_SUPPRESSION=true
POST_PLAYBACK_DRAIN_MS=400
MIN_SPEECH_CHUNKS_TO_START=8
BARGE_IN_ECHO_DRAIN_FRAMES=2
INTERRUPTION_ENERGY_THRESHOLD=500

BARGE_IN_ENERGY_THRESHOLD=2500
BARGE_IN_CHUNKS_NEEDED=3

# NeMo Guardrails
GUARDRAILS_CONFIG_PATH=config/guardrails
GUARDRAILS_ENABLED=true

# Echo Guard (L2/L3) Tuning
ECHO_COOLDOWN_S=0.5
ECHO_SIMILARITY_THRESHOLD=0.55
ECHO_SIMILARITY_WINDOW_S=3.0
