# Copy this file to .env in the repo root and fill in your real values.
# .env itself is gitignored - never commit real credentials.

# ---- Required ----
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# ---- Audio devices (optional - auto-detected via PulseAudio when unset) ----
# AUDIO_INPUT_DEVICE_INDEX=
# AUDIO_OUTPUT_DEVICE_INDEX=

# ---- Display (optional) ----
# FACE_ENABLED=true
# DISPLAY_BACKEND=auto

# ---- Wake word (optional) ----
# WAKE_WORD_MODEL=
# WAKE_WORD_THRESHOLD=0.5

# ---- Echo cancellation, Linux/Pi only (optional) ----
# ENABLE_SPEEX_NOISE_SUPPRESSION=true

# ---- Local LLM fallback if Azure is unreachable (optional) ----
# LOCAL_LLM_MODEL_PATH=

# ---- Misc (optional, all have sane defaults) ----
# SAMPLE_RATE=16000
# VAD_AGGRESSIVENESS=3
# MAX_CONVERSATION_HISTORY=20
# TTS_VOICE=
# GUARDRAILS_CONFIG_PATH=config/guardrails
# LOG_LEVEL=INFO
